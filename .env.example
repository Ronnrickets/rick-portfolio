# Project URL from Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only sb_secret_ key from Supabase: Project Settings > API Keys.
# Never prefix this with NEXT_PUBLIC_ or expose it in a client component.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISITOR_HASH_SECRET=replace-with-at-least-32-random-characters
